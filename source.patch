+    /// Replace the catalogue in the dedicated bridge database atomically.
+    pub async fn replace_bridge_models(&self, inputs: &[ModelConfigInput]) -> Result<()> {
+        if inputs.is_empty() { return Err(Error::Config("empty bridge catalogue".into())); }
+        let mut hashes = HashSet::new();
+        let mut normalized = Vec::new();
+        for input in inputs {
+            let input = normalize_model_input(input)?;
+            let hash = model_hash(&input)?;
+            if !hashes.insert(hash.clone()) { return Err(Error::Config("duplicate bridge model".into())); }
+            normalized.push((hash, input));
+        }
+        let _write = self.writes.lock().await;
+        let mut transaction = self.pool.begin().await?;
+        // Calls keep their request/response bodies; removing a catalogue must not violate FK constraints.
+        sqlx::query("UPDATE llm_calls SET model_hash = NULL").execute(&mut *transaction).await?;
+        sqlx::query("DELETE FROM model_configs").execute(&mut *transaction).await?;
+        let now = now_ms();
+        for (hash, input) in normalized { insert_model(&mut transaction, &hash, &input, now).await?; }
+        transaction.commit().await?;
+        Ok(())
+    }
