+    /// Run only the loopback proxy. The caller owns settings and process lifecycle.
+    pub async fn start_proxy_only(&self) -> Result<String> {
+        if !matches!(self.inner.ca.state()?, CaState::Ready) {
+            return Err(Error::Config("bridge requires an already trusted CA".into()));
+        }
+        let backend = self.inner.backend_addr.read()
+            .ok_or_else(|| Error::Config("bridge backend is not ready".into()))?;
+        let mut proxy = self.inner.proxy.lock().await;
+        if let Some(url) = proxy.url() { return Ok(url); }
+        *self.inner.tab_mode.write() = TabMode::Direct;
+        // Reuse the port persisted by a previous run so Cursor's `http.proxy`
+        // keeps pointing at a live listener across bridge restarts.
+        let requested_port = self.inner.store.port_settings().await?.proxy_port;
+        let (url, actual_port) = proxy.start(backend, self.inner.ca.load()?, requested_port, self.inner.tab_mode.clone()).await?;
+        if let Err(error) = self.inner.store.set_proxy_port(actual_port).await {
+            proxy.stop().await;
+            return Err(error);
+        }
+        Ok(url)
+    }
+
+    pub async fn stop_proxy_only(&self) {
+        self.inner.proxy.lock().await.stop().await;
+    }
